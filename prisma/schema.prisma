generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  events        Event[]
  planSections  PlanSection[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String            @id @default(cuid())
  name        String
  type        String
  date        DateTime?
  location    String?
  guestCount  Int               @default(0)
  budget      Float             @default(0)
  currency    String            @default("INR")
  theme       String?
  style       String?
  description String?
  notes       String?
  constraints String?
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  BudgetCategory[]
  expenses    Expense[]
  tasks       Task[]
  vendors     Vendor[]
  guests      Guest[]
  planSections PlanSection[]
  proposals   ChangeProposal[]
}

model BudgetCategory {
  id            String    @id @default(cuid())
  eventId       String
  name          String
  allocation    Float     @default(0)
  spent         Float     @default(0)
  notes         String?
  isContingency Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses      Expense[]
}

model Expense {
  id         String          @id @default(cuid())
  eventId    String
  categoryId String?
  title      String
  amount     Float
  isActual   Boolean         @default(false)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Task {
  id          String    @id @default(cuid())
  eventId     String
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("pending")
  priority    String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        String      @id @default(cuid())
  eventId   String
  name      String
  category  String
  contact   String?
  status    String      @default("prospect")
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotations Quotation[]
}

model Quotation {
  id          String   @id @default(cuid())
  vendorId    String
  amount      Float
  currency    String   @default("INR")
  isConfirmed Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Guest {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  email        String?
  dietaryNotes String?
  plusOne      Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp         RSVP?
}

model RSVP {
  id          String    @id @default(cuid())
  guestId     String    @unique
  status      String    @default("pending")
  notes       String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model PlanSection {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  title       String
  content     String
  assumptions String?
  tradeOffs   String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChangeProposal {
  id         String   @id @default(cuid())
  eventId    String
  kind       String
  summary    String
  impactText String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model RateLimitBucket {
  key          String   @id
  attempts     Int
  windowEndsAt DateTime
  updatedAt    DateTime @updatedAt

  @@index([windowEndsAt])
}
